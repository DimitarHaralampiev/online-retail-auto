# Local PostgreSQL; use a dedicated database and user.
DATABASE_URL=postgresql://auto:local-development-only@127.0.0.1:5433/auto

APP_URL=http://localhost:3000
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=Auto Shop <noreply@example.test>
# For production SMTP:
# SMTP_USER=
# SMTP_PASSWORD=

# live loads real offices; demo explicitly uses fictional fixtures.
COURIER_OFFICES_MODE=live
# Speedy requires separate REST API credentials, kept server-side.
SPEEDY_API_USER=
SPEEDY_API_PASSWORD=

# Current catalog/stock are demo-only. Real payments are deliberately disabled.
ORDERS_MODE=test
TEST_SHIPPING_CENTS=500
# Generate a private random 32-byte hex value; do not reuse this placeholder.
ORDER_TRACKING_SECRET=
# Optional Stripe test integration. Both are required to enable card checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# simulator is available only locally in development; stripe uses test keys.
PAYMENT_PROVIDER=simulator

# Customer notification worker: npm run customers:worker -- --watch
SMTP_CUSTOMER_FROM=
SMTP_ORDERS_FROM=
SMTP_SUPPORT_REPLY_TO=
# Free delivery only when discounted goods subtotal is strictly above this amount.
FREE_SHIPPING_ABOVE_CENTS=3000
# Server-only; never NEXT_PUBLIC_. Real API calls incur usage charges.
OPENAI_API_KEY=
OPENAI_INVOICE_MODEL=gpt-4.1
OPENAI_MARKET_MODEL=gpt-4.1
OPENAI_INSIGHTS_MODEL=gpt-4.1
