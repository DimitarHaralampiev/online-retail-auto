{
  "name": "online-retail-auto",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/lib/*.test.ts",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "admin:grant": "node --env-file=.env.local scripts/grant-admin.mjs",
    "orders:send-emails": "node --env-file=.env.local --import tsx scripts/send-order-emails.ts",
    "test:orders": "node --env-file=.env.local --import tsx scripts/test-order-flow.ts",
    "mail:check": "node --env-file=.env.local --import tsx scripts/check-mail.ts",
    "customers:worker": "node --env-file=.env.local --import tsx scripts/customer-worker.ts",
    "test:features": "node --env-file=.env.local --import tsx scripts/test-customer-invoices.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 16",
    "test:integration": "node --import tsx --test --test-concurrency=4 tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:docker": "scripts/e2e-docker.sh",
    "db:seed:demo": "node --env-file=.env.local --import tsx scripts/seed-demo-catalog.ts",
    "orders:release-expired": "node --env-file=.env.local --import tsx scripts/release-expired-reservations.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/roboto-condensed": "^5.3.0",
    "cheerio": "^1.2.0",
    "next": "16.4.6",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20.18.1"
  }
}
