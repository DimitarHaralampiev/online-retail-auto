# Copy to deploy/backup.env on the server (never commit it). Only the backup
# container reads it. docs/operations/backups.md
# Daily backup time (UTC, HH:MM) and how many local dumps to keep.
BACKUP_AT=02:30
BACKUP_KEEP=14
# Off-site copy: an rclone crypt remote over the storage you chose, set up
# with RCLONE_CONFIG_* variables (example for an S3-compatible bucket):
#   RCLONE_CONFIG_STORE_TYPE=s3
#   RCLONE_CONFIG_STORE_PROVIDER=Other
#   RCLONE_CONFIG_STORE_ENDPOINT=https://<region>.your-objectstorage.example
#   RCLONE_CONFIG_STORE_ACCESS_KEY_ID=
#   RCLONE_CONFIG_STORE_SECRET_ACCESS_KEY=
#   RCLONE_CONFIG_OFFSITE_TYPE=crypt
#   RCLONE_CONFIG_OFFSITE_REMOTE=store:<bucket>/auto-shop
#   RCLONE_CONFIG_OFFSITE_PASSWORD=<output of: rclone obscure <long random password>>
#   BACKUP_REMOTE=offsite:production
# Keep the crypt password somewhere safe outside the server too: without it
# the off-site copies cannot be read.
BACKUP_REMOTE=
BACKUP_REMOTE_KEEP_DAYS=30
# Failed backups and restore checks are reported here (same as app.env).
SENTRY_DSN=
