# Copy to deploy/.env on the server (never commit it). docs/operations/runbook.md
# production or staging: names the containers, volumes and error reports.
SHOP_ENVIRONMENT=production
# Database password, letters and digits only: openssl rand -hex 32
DB_PASSWORD=
# Port on 127.0.0.1 that the reverse proxy forwards to (staging: 3001).
WEB_PORT=3000
# Where deploy.sh pulls the images from (published by CI on every merge).
SHOP_IMAGES=ghcr.io/dimitarharalampiev/online-retail-auto
